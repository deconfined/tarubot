        { "name": "TARUBOT_ENVIRONMENT", "value": "prod" },
        { "name": "PUBLIC_TEST_RESPONSES", "value": "false" },
        { "name": "GITHUB_APP_CLIENT_ID", "value": "Iv23liInvented" },
        { "name": "DISCORD_APPLICATION_ID", "value": "APPLICATION_ID" },
        { "name": "TEST_GUILD_ID", "value": "" }
      ]
