{
  "comment": "Cases for tests/fixtures/bot-asserts.py: ops/ansible/bot.yml's own expressions, evaluated by ansible-core's templar. Each names a task by its exact name and one of its fields; every value is invented.",
  "cases": [
    {
      "name": "suggest: a target with /suggest reads the client ID on deploy",
      "task": "Check /suggest's client ID, and keep it only when well formed",
      "field": "when",
      "vars": { "tarubot_suggest": true, "tarubot_action": "deploy" },
      "expect": true
    },
    {
      "name": "suggest: and on bot",
      "task": "Check /suggest's client ID, and keep it only when well formed",
      "field": "when",
      "vars": { "tarubot_suggest": true, "tarubot_action": "bot" },
      "expect": true
    },
    {
      "name": "suggest: never on a preflight",
      "task": "Check /suggest's client ID, and keep it only when well formed",
      "field": "when",
      "vars": { "tarubot_suggest": true, "tarubot_action": "preflight" },
      "expect": false
    },
    {
      "name": "suggest: never on a target without /suggest",
      "task": "Check /suggest's client ID, and keep it only when well formed",
      "field": "when",
      "vars": { "tarubot_suggest": false, "tarubot_action": "deploy" },
      "expect": false
    },
    {
      "name": "suggest: never on a target that doesn't say (staging)",
      "task": "Check /suggest's client ID, and keep it only when well formed",
      "field": "when",
      "vars": { "tarubot_action": "deploy" },
      "expect": false
    },
    {
      "name": "suggest: an empty client ID is allowed (/suggest off)",
      "task": "Check /suggest's client ID, and keep it only when well formed",
      "field": "tb_client_ok",
      "env": { "GITHUB_APP_CLIENT_ID": "" },
      "expect": true
    },
    {
      "name": "suggest: an unset client ID is allowed (/suggest off)",
      "task": "Check /suggest's client ID, and keep it only when well formed",
      "field": "tb_client_ok",
      "env": {},
      "expect": true
    },
    {
      "name": "suggest: a client ID of the pattern is allowed",
      "task": "Check /suggest's client ID, and keep it only when well formed",
      "field": "tb_client_ok",
      "env": { "GITHUB_APP_CLIENT_ID": "Iv23liInvented.id_0-9" },
      "expect": true
    },
    {
      "name": "suggest: 64 characters are allowed",
      "task": "Check /suggest's client ID, and keep it only when well formed",
      "field": "tb_client_ok",
      "env": {
        "GITHUB_APP_CLIENT_ID": "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789._"
      },
      "expect": true
    },
    {
      "name": "suggest: 65 characters are refused",
      "task": "Check /suggest's client ID, and keep it only when well formed",
      "field": "tb_client_ok",
      "env": {
        "GITHUB_APP_CLIENT_ID": "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789._-"
      },
      "expect": false
    },
    {
      "name": "suggest: a trailing newline is refused",
      "task": "Check /suggest's client ID, and keep it only when well formed",
      "field": "tb_client_ok",
      "env": { "GITHUB_APP_CLIENT_ID": "Iv23liInvented\n" },
      "expect": false
    },
    {
      "name": "suggest: a leading space is refused",
      "task": "Check /suggest's client ID, and keep it only when well formed",
      "field": "tb_client_ok",
      "env": { "GITHUB_APP_CLIENT_ID": " Iv23liInvented" },
      "expect": false
    },
    {
      "name": "suggest: an inner space is refused",
      "task": "Check /suggest's client ID, and keep it only when well formed",
      "field": "tb_client_ok",
      "env": { "GITHUB_APP_CLIENT_ID": "Iv23li Invented" },
      "expect": false
    },
    {
      "name": "suggest: a slash is refused",
      "task": "Check /suggest's client ID, and keep it only when well formed",
