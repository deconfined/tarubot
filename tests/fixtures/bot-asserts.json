        "tb_client_id": "Iv23liInvented"
      },
      "expect": ["DATABASE_CA_CERT", "DATABASE_URL", "DISCORD_TOKEN", "GITHUB_APP_PRIVATE_KEY"]
    },
    {
      "name": "suggest: no client ID, no key",
      "task": "Work out which secrets the container mounts",
      "field": "tb_container_secrets",
      "vars": {
        "tarubot_action": "bot",
        "tarubot_secrets": ["DATABASE_CA_CERT", "DATABASE_URL", "DISCORD_TOKEN"],
        "tb_client_id": ""
      },
      "expect": ["DATABASE_CA_CERT", "DATABASE_URL", "DISCORD_TOKEN"]
