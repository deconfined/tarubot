      "field": "that",
      "vars": {
        "tarubot_settings": { "TARUBOT_ENVIRONMENT": "staging", "GITHUB_APP_CLIENT_ID": "" }
      },
      "expect": true
    },
    {
      "name": "suggest: a client ID in a /suggest target's plain settings is refused",
      "task": "Check the target's /suggest switch",
      "field": "that",
      "vars": {
        "tarubot_suggest": true,
        "tarubot_settings": { "TARUBOT_ENVIRONMENT": "prod", "GITHUB_APP_CLIENT_ID": "" }
      },
