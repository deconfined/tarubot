      },
      "expect": ["DATABASE_CA_CERT", "DATABASE_URL"]
    },
    {
      "name": "suggest: the app's key is then required, with the backup's settings",
      "task": "Work out which secrets this action needs",
      "field": "tb_required",
      "vars": {
        "tb_container_secrets": ["DATABASE_URL", "GITHUB_APP_PRIVATE_KEY"],
