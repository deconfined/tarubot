        "HEALTHCHECKS_BACKUP_URL"
      ]
    },
    {
      "name": "suggest: the refusals name the environment's secrets",
      "task": "Start the lists of missing and malformed settings",
      "field": "tb_secret_names",
      "expect": {
        "BACKUP_STORAGE_ACCESS_KEY": "BACKUP_STORAGE_ACCESS_KEY",
        "BACKUP_STORAGE_ENDPOINT": "BACKUP_STORAGE_ENDPOINT",
        "BACKUP_STORAGE_REGION": "BACKUP_STORAGE_REGION",
        "BACKUP_STORAGE_SECRET_KEY": "BACKUP_STORAGE_SECRET_KEY",
        "DATABASE_CA_CERT": "DATABASE_CA_CERT",
        "DATABASE_URL": "DATABASE_URL",
        "DISCORD_TOKEN": "DISCORD_TOKEN",
        "GITHUB_APP_PRIVATE_KEY": "SUGGEST_APP_PRIVATE_KEY",
        "GITHUB_REPORTS_TOKEN": "REPORTS_GITHUB_TOKEN",
        "HEALTHCHECKS_BACKUP_URL": "HEALTHCHECKS_BACKUP_URL",
        "HEALTHCHECKS_PING_URL": "HEALTHCHECKS_PING_URL",
        "GITHUB_APP_CLIENT_ID": "SUGGEST_APP_CLIENT_ID"
      }
    },
    {
      "name": "suggest: a target with /suggest and its switch alone passes",
      "task": "Check the target's /suggest switch",
      "field": "that",
      "vars": {
        "tarubot_suggest": true,
        "tarubot_settings": { "TARUBOT_ENVIRONMENT": "prod", "PUBLIC_TEST_RESPONSES": "false" }
      },
      "expect": true
