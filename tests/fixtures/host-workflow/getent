#!/usr/bin/env bash
# A simulated `getent ahosts NAME` for tests/unit/host-workflow.test.ts: $STUB/hosts/<NAME> holds
# the addresses NAME resolves to, one a line, printed as glibc's getent prints them (three lines
# per address, the canonical name on the first). No file is getent's "not found" (exit 2).
set -euo pipefail
[[ $1 == ahosts && $# -eq 2 ]] || exit 1
file=$STUB/hosts/$2
[[ -f $file ]] || exit 2
first=true
while IFS= read -r address; do
  [[ -n $address ]] || continue
  if [[ $first == true ]]; then
    printf '%-15s STREAM %s\n' "$address" "$2"
    first=false
  else
    printf '%-15s STREAM\n' "$address"
  fi
  printf '%-15s DGRAM\n%-15s RAW\n' "$address" "$address"
done <"$file"
