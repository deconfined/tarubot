#!/usr/bin/env bash
# A simulated `ssh-keyscan -q -T 20 -t ed25519 -- ADDRESS` for tests/unit/host-workflow.test.ts:
# $STUB/keys/<ADDRESS> holds the key lines the address offers (`ssh-ed25519 <base64>`), printed
# after the address as ssh-keyscan prints them. No file is an address that doesn't answer (no
# route from the runner): nothing on standard output, a complaint naming the address on standard
# error, and exit 1, as OpenSSH 9 does when it finds no key. Every call is recorded in
# $STUB/keyscan-calls.
set -euo pipefail
printf '%s\n' "$*" >>"$STUB/keyscan-calls"
[[ $# -eq 7 && $1 == -q && $2 == -T && $3 == 20 && $4 == -t && $5 == ed25519 && $6 == -- ]] || exit 64
file=$STUB/keys/$7
if [[ ! -f $file ]]; then
  printf 'connect (`%s'\''): Network is unreachable\n' "$7" >&2
  exit 1
fi
while IFS= read -r line; do
  [[ -n $line ]] && printf '%s %s\n' "$7" "$line"
done <"$file"
exit 0
