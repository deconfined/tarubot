#!/usr/bin/env bash
set -Eeuo pipefail
printf 'age %s\n' "$*" >>"$SIM/argv"
output='' input=''
while (( $# )); do
  case $1 in
    --encrypt) shift ;;
    --recipients-file) [[ -s $2 ]]; shift 2 ;;
    --output) output=$2; shift 2 ;;
    *) input=$1; shift ;;
  esac
done
if [[ -z $input ]]; then
  data=$(cat)
  [[ $data == database-plaintext-marker* ]]
  printf '%s\n' age-database >>"$SIM/events"
else
  [[ $input == "$HOME/tarubot/.env" ]]
  printf '%s\n' age-settings >>"$SIM/events"
fi
[[ ! -e $SIM/fail-age ]]
# Simulate opaque ciphertext, never copy plaintext into the output fixture.
printf '%8192s\n' AGE-ENCRYPTED >"$output"
