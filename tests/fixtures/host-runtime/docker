#!/usr/bin/env bash
set -Eeuo pipefail
printf 'docker %s\n' "$*" >>"$SIM/argv"
record() { printf '%s\n' "$*" >>"$SIM/events"; }
fail() { [[ ! -e $SIM/fail-$1 ]]; }
case $1 in
  ps)
    # Stopped one-off containers a killed `compose run` left behind: whatever oneoffs lists.
    if [[ $* == *'oneoff=True'* ]]; then
      if [[ -f $SIM/oneoffs ]]; then cat "$SIM/oneoffs"; fi
      exit 0
    fi
    file=$SIM/container.json
    if [[ $* == *'service=caddy'* ]]; then file=$SIM/proxy.json; fi
    # The bot container vanishes once observation has begun.
    if [[ -e $SIM/fail-gone && -e $SIM/observed && $file == "$SIM/container.json" ]]; then exit 0; fi
    if [[ -f $file ]] && { [[ $2 == -aq ]] || jq -e '.[0].State.Running' "$file" >/dev/null; }; then
      jq -r '.[0].Id' "$file"
    fi
    ;;
  inspect)
    if [[ -f $SIM/proxy.json && $2 == $(jq -r '.[0].Id' "$SIM/proxy.json") ]]; then
      if [[ -e $SIM/fail-proxy-health && -e $SIM/observed ]]; then
        jq '.[0].State.Health.Status = "unhealthy"' "$SIM/proxy.json"
      else cat "$SIM/proxy.json"; fi
      exit 0
    fi
    if [[ -e $SIM/fail-inspect && -e $SIM/started ]]; then exit 1; fi
    if [[ -e $SIM/fail-restart && -e $SIM/observed ]]; then
      jq '.[0].RestartCount = 1' "$SIM/container.json"
    else cat "$SIM/container.json"; fi
    ;;
  image)
    key=target
    if [[ $3 == $(jq -r .live.id "$SIM/config.json") ]]; then key=live; fi
    jq --arg key "$key" '[.[$key] | {Id:.id,RepoDigests:["ghcr.io/deconfined/tarubot@"+.digest],Config:{Labels:{"org.opencontainers.image.version":.version,"org.opencontainers.image.revision":.commit}}}]' "$SIM/config.json" >"$SIM/image.json"
    if [[ $key == target && -e $SIM/fail-label ]]; then
      jq '.[0].Config.Labels["org.opencontainers.image.revision"] = "wrong"' "$SIM/image.json"
    elif [[ $key == target && -e $SIM/fail-digest ]]; then
      jq '.[0].RepoDigests = []' "$SIM/image.json"
    else cat "$SIM/image.json"; fi
    ;;
  rm)
    record reap
    fail reap
    : >"$SIM/oneoffs"
    ;;
  pull) record "pull $2"; fail pull ;;
  update)
    [[ $2 == --restart && $3 == unless-stopped ]]
    [[ -f $HOME/.local/state/tarubot-deploy/current ]]
    file=$SIM/container.json
    action=restart-policy
    if [[ -f $SIM/proxy.json && $4 == $(jq -r '.[0].Id' "$SIM/proxy.json") ]]; then
      file=$SIM/proxy.json
      action=proxy-restart-policy
    else
      [[ $4 == $(jq -r '.[0].Id' "$file") ]]
    fi
    record "$action"
    jq '.[0].HostConfig.RestartPolicy.Name = "unless-stopped"' "$file" >"$SIM/next.json"
    mv "$SIM/next.json" "$file"
    fail "$action"
    ;;
  stop)
    if [[ -f $SIM/proxy.json && ${*: -1} == $(jq -r '.[0].Id' "$SIM/proxy.json") ]]; then
      record proxy-stop
      jq '.[0].State.Running = false' "$SIM/proxy.json" >"$SIM/next.json"
      mv "$SIM/next.json" "$SIM/proxy.json"
      exit 0
    fi
    record stop
    [[ -f $HOME/.local/state/tarubot-deploy/pending ]]
    fail stop
    jq '.[0].State.Running = false' "$SIM/container.json" >"$SIM/next.json"
    mv "$SIM/next.json" "$SIM/container.json"
    ;;
  exec)
    if [[ ${*: -1} == production || ${*: -1} == staging ]]; then
      record scope-live
      "$BUN_REAL" --no-env-file "$SCOPE_FIXTURE" "$SIM/live-env.json" "$SIM/live-runtime" "$5" "$6"
    else
      # The release that owns the container being observed: the restored previous one answers as
      # the live release, with its own events and knobs.
      release=target observed=observe probe=probe
      if [[ $2 == c0ffee000003 ]]; then release=live observed=restore-observe probe=restore-observe; fi
      record "$observed"
      touch "$SIM/observed"
      [[ ${*: -2:1} == $(jq -r ".$release.version" "$SIM/config.json") && ${*: -1} == 001_initial.sql ]]
      # fail-probe: the exec itself fails without a word, as a crashed container would.
      fail "$probe"
      # Otherwise run the entry's actual probe against invented package, schema and readiness
      # state (observe.json); the probe's own JSON line is the public diagnostic's input.
      runtime=$SIM/observe-runtime
      jq -n --arg release "$release" --slurpfile config "$SIM/config.json" --argjson scenario "$(cat "$SIM/observe.json" 2>/dev/null || echo '{}')" \
        '{version: ($scenario.version // $config[0][$release].version)}' >"$runtime/package.json"
      cd "$runtime"
      exec "$BUN_REAL" --no-env-file --preload "$OBSERVE_FIXTURE" -e "$5" "$6" "$7"
    fi
    ;;
  logs)
    [[ $2 == --tail ]]
    # hold-logs: block here, inside the entry's diagnosis, until the test removes the file.
    if [[ -e $SIM/hold-logs ]]; then
      touch "$SIM/logs-held"
      while [[ -e $SIM/hold-logs ]]; do /bin/sleep 0.05; done
    fi
    if [[ -f $SIM/bot.log ]]; then cat "$SIM/bot.log"; fi
    ;;
  compose)
    shift
    root='' env_file='' manifest='' project=''
    profiles=()
    while [[ $1 == --* || $1 == -f ]]; do
      case $1 in
        --project-name) project=$2 ;;
        --project-directory) root=$2 ;;
        --env-file) env_file=$2 ;;
        -f) manifest=$2 ;;
        --profile) profiles+=("$2") ;;
        *) exit 90 ;;
      esac
      shift 2
    done
    [[ $project == tarubot && $env_file == "$HOME/tarubot/.env" ]]
    # Published immutable backup uses the root; updated entries use the release.
    [[ $root == "${manifest%/*}" || $root == "$HOME/tarubot" ]]
    [[ -f $manifest ]]
    # The requested release, or the live (previous) one when the entry rehearses or performs a restore.
    previous=false
    if [[ ${TARUBOT_IMAGE_DIGEST:-} == $(jq -r .live.digest "$SIM/config.json") ]]; then previous=true; fi
    [[ $previous == true || ${TARUBOT_IMAGE_DIGEST:-} == $(jq -r .target.digest "$SIM/config.json") ]]
    case $1 in
      config)
        if [[ $previous == true ]]; then
          # The restore kit's rehearsal of the previous release's manifest (kept apart from the model
          # of the requested release, which other assertions read).
          record restore-config
          fail restore-config
          "$BUN_REAL" --env-file "$env_file" "$COMPOSE_FIXTURE" "$manifest" "$root" "${profiles[@]}" >"$SIM/compose-previous.json"
          if [[ -e $SIM/fail-restore-restart-config ]]; then
            jq '.services.tarubot.restart = "unless-stopped"' "$SIM/compose-previous.json"
          else cat "$SIM/compose-previous.json"; fi
          exit 0
        fi
        record config
        fail config
        "$BUN_REAL" --env-file "$env_file" "$COMPOSE_FIXTURE" "$manifest" "$root" "${profiles[@]}" >"$SIM/compose.json"
        if [[ -e $SIM/fail-restart-config ]]; then
          jq '.services.tarubot.restart = "unless-stopped"' "$SIM/compose.json"
        else cat "$SIM/compose.json"; fi
        ;;
      pull)
        [[ $2 == caddy ]]
        jq -e '.services.caddy' "$SIM/compose.json" >/dev/null
        record proxy-pull
        fail proxy-pull
        ;;
      run)
        case "$*" in
          *'caddy caddy validate '*)
            [[ $* == *'--pull never'* && $* == *'--config /etc/caddy/Caddyfile --adapter caddyfile'* ]]
            mount=$(jq -er '.services.caddy.volumes[] | select(startswith("/") and contains(":/etc/caddy/Caddyfile:ro"))' "$SIM/compose.json")
            [[ ${mount%%:*} == "${manifest%/*}/ops/Caddyfile" && -f ${mount%%:*} ]]
            record proxy-validate
            fail proxy-validate
            if [[ -n ${CADDY_NATIVE_DOCKER:-} ]]; then
              "$CADDY_NATIVE_DOCKER" compose --project-name "$CADDY_NATIVE_PROJECT" \
                --project-directory "$root" --env-file "$env_file" \
                -f "$manifest" -f "$SIM/native-caddy.yml" "$@"
            fi
            ;;
          *'candidate-check.js")'*)
            # Whether the candidate image holds the offline check (images older than it don't).
            [[ $* == *'--pull never'* ]]
            record candidate-present
            if [[ -e $SIM/no-candidate-check ]]; then printf 'false\n'; else printf 'true\n'; fi
            ;;
          *candidate-check.js*)
            [[ $* == *'--pull never'* ]]
            # VERSION SCHEMA, then the scope the entry registers in.
            version=$(jq -r .target.version "$SIM/config.json")
            if [[ $(jq -r .deploymentTarget "$SIM/config.json") == staging ]]; then
              [[ ${*: -4} == "$version 001_initial.sql --guild $(jq -r .TEST_GUILD_ID "$SIM/candidate-env.json")" ]]
            else
              [[ ${*: -3} == "$version 001_initial.sql --global" ]]
            fi
            record candidate-check
            # fail-candidate-check holds the failing part (empty: none named, as a crash would).
            if [[ -e $SIM/fail-candidate-check ]]; then
              part=$(cat "$SIM/fail-candidate-check")
              printf '%s\n' 'registration: moderate/block/reason: required option after an optional one' >&2
              if [[ -n $part ]]; then
                printf '{"check":"%s","identity":true,"config":true,"modules":true,"registration":false}\n' "$part"
              fi
              exit 1
            fi
            printf '%s\n' '{"check":"ok","identity":true,"config":true,"modules":true,"registration":true}'
            ;;
          *'restore-probe'*)
            # The previous image's own read-only schema check (marker: restore-probe).
            [[ $* == *'--pull never'* && $previous == true ]]
            record restore-probe
            fail restore-probe
            state=accept
            if [[ -f $SIM/probe-state ]]; then state=$(cat "$SIM/probe-state"); fi
            if [[ $state == crash ]]; then exit 1; fi
            if [[ $state == noline ]]; then exit 0; fi
            printf '{"state":"%s","schema":"001_initial.sql"}\n' "$state"
            ;;
          *'tarubot bun -e '*)
            [[ $* == *'--pull never'* ]]
            code=${@: -2:1}
            if [[ $code == *'webSettings'* ]]; then record web-candidate; else record scope-candidate; fi
            jq '.services.tarubot.environment' "$SIM/compose.json" >"$SIM/candidate-env.json"
            "$BUN_REAL" --no-env-file "$SCOPE_FIXTURE" "$SIM/candidate-env.json" "$SIM/runtime" "$code" "${@: -1}"
            ;;
          *backup)
            record backup
            # hold-backup: block here, mid-backup, until the test removes the file (to signal the entry).
            if [[ -e $SIM/hold-backup ]]; then
              touch "$SIM/backup-held"
              while [[ -e $SIM/hold-backup ]]; do /bin/sleep 0.05; done
            fi
            fail backup
            printf 'database-plaintext-marker'; printf '%8192s' padding
            ;;
          *migrate.js)
            [[ $* == *'--pull never'* ]]
            record migrate
            if [[ -e $SIM/fail-migrate && -f $SIM/migrate-output ]]; then cat "$SIM/migrate-output" >&2; fi
            # migrate-commits: the transaction committed although the run failed (a lost acknowledgement),
            # so the previous image's schema check now refuses the database; migrate-unknown: it can't tell.
            if [[ -e $SIM/migrate-commits ]]; then printf 'ahead\n' >"$SIM/probe-state"; fi
            if [[ -e $SIM/migrate-unknown ]]; then printf 'unknown\n' >"$SIM/probe-state"; fi
            fail migrate
            printf '%s\n' 'Schema ready.'
            ;;
          *register.js*)
            [[ $* == *'--pull never'* ]]
            scope=$(jq -r .deploymentTarget "$SIM/config.json")
            kind=register
            if [[ $previous == true ]]; then kind=restore-register; fi
            if [[ $scope == staging ]]; then
              [[ $* == *'--guild '* && $* != *'--global'* && ${*: -1} == $(jq -r .TEST_GUILD_ID "$SIM/candidate-env.json") ]]
              record "$kind-guild"
            else
              [[ $* == *'--global' && $* != *'--guild'* ]]
              record "$kind-global"
            fi
            record "$kind"
            fail "$kind"
            ;;
          *) exit 91 ;;
        esac
        ;;
      up)
        [[ $* == *'--pull never'* && $* == *'--force-recreate'* && $* == *'--wait'* ]]
        if [[ ${*: -1} == caddy ]]; then
          jq -e '.[0].State.Running and .[0].State.Health.Status == "healthy"' "$SIM/container.json" >/dev/null
          jq -e '.services.caddy' "$SIM/compose.json" >/dev/null
          record proxy-start
          jq -n --arg restart "${TARUBOT_RESTART_POLICY:-unless-stopped}" \
            '[{Id:"cadd10000001",HostConfig:{RestartPolicy:{Name:$restart}},State:{Running:true,Health:{Status:"healthy"}}}]' >"$SIM/proxy.json"
          fail proxy-start
          if [[ -e $SIM/fail-proxy-ready ]]; then
            jq '.[0].State.Health.Status = "unhealthy"' "$SIM/proxy.json" >"$SIM/next.json"
            mv "$SIM/next.json" "$SIM/proxy.json"
            exit 1
          fi
          record proxy-ready
          exit 0
        fi
        release=target id=c0ffee000002 started=start
        if [[ $previous == true ]]; then release=live id=c0ffee000003 started=restore-up; fi
        record "$started"
        jq --arg release "$release" --arg id "$id" --arg restart "${TARUBOT_RESTART_POLICY:-unless-stopped}" '[.[$release] | {Id:$id,Image:.id,RestartCount:0,HostConfig:{RestartPolicy:{Name:$restart}},State:{Running:true,Health:{Status:"healthy"}},Config:{Image:("ghcr.io/deconfined/tarubot@"+.digest),Labels:{"org.opencontainers.image.version":.version,"org.opencontainers.image.revision":.commit,"com.docker.compose.project":"tarubot","com.docker.compose.oneoff":"False"}}}]' "$SIM/config.json" >"$SIM/container.json"
        # after-start.jq: what became of the new container while Compose waited for it.
        if [[ -f $SIM/after-start.jq ]]; then
          jq -f "$SIM/after-start.jq" "$SIM/container.json" >"$SIM/next.json"
          mv "$SIM/next.json" "$SIM/container.json"
        fi
        if [[ $previous == true ]]; then
          touch "$SIM/restored"
          fail restore-up
          exit 0
        fi
        touch "$SIM/started"
        fail start
        ;;
      *) exit 92 ;;
    esac
    ;;
  *) exit 93 ;;
esac
