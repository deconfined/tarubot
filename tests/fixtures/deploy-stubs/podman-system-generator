#!/usr/bin/env bash
# A stand-in for Podman's Quadlet generator (`podman-system-generator --user --dryrun`) for
# tests/unit/deploy-script.test.ts. Like Podman 5.8.2's, it reads ~/.config/containers/systemd,
# follows the links, names each file it loads on stderr ("Loading source unit file PATH",
# "Loading source drop-in file PATH", with the links resolved) and prints each generated unit
# after a ---NAME--- header on stdout. Its ExecStart passes the [Container] EnvironmentFile= lines
# of the unit and then of its drop-ins, and ends with the unit's Image=. It records "generator".
# Knobs ($SIM/knob/generator): fail (an error, exit 1), empty (no unit, exit 0, as the real one
# does), stray (another unit elsewhere) and dropin (a stray drop-in elsewhere in the search path).
set -euo pipefail
# shellcheck source=tests/fixtures/deploy-stubs/sim.sh
source "$DEPLOY_STUBS/sim.sh"
trace podman-system-generator "$@"
[[ $* == '--user --dryrun' ]] || exit 2
record generator
log() { printf 'quadlet-generator[4242]: %s\n' "$*" >&2; }
mode=$(knob generator)
case $mode in
  fail)
    log 'converting "tarubot.container": no Image key specified'
    exit 1
    ;;
  empty) exit 0 ;;
esac

dirs=()
for link in "$HOME/.config/containers/systemd"/*; do
  dirs+=("$(readlink -f "$link")")
done
unit='' dropins=()
for dir in "${dirs[@]}"; do
  if [[ -f $dir/tarubot.container ]]; then
    unit=$dir/tarubot.container
    log "Loading source unit file $unit"
  fi
done
[[ -n $unit ]] || exit 0
for dir in "${dirs[@]}"; do
  for file in "$dir"/tarubot.container.d/*.conf; do
    [[ -f $file ]] || continue
    dropins+=("$file")
    log "Loading source drop-in file $file"
  done
done
if [[ $mode == dropin ]]; then
  log "Loading source drop-in file /etc/containers/systemd/users/tarubot.container.d/99-stray.conf"
fi
args=()
for file in "$unit" "${dropins[@]}"; do
  while IFS= read -r line; do
    args+=(--env-file "${line#EnvironmentFile=}")
  done < <(grep '^EnvironmentFile=%h/tarubot/ops/quadlet/' "$file")
done
image=$(sed -n 's/^Image=//p' "$unit")
printf -- '---tarubot.service---\n[Unit]\nDescription=TaruBot\nSourcePath=%s\n\n' "$unit"
printf '[Service]\nEnvironmentFile=%%h/tarubot/.env\n'
printf 'ExecStart=/usr/bin/podman run --name tarubot --replace --rm --log-driver journald %s %s\n\n' \
  "${args[*]}" "$image"
if [[ $mode == stray ]]; then
  log "Loading source unit file /etc/containers/systemd/users/other.container"
  printf -- '---other.service---\n[Service]\nExecStart=/usr/bin/podman run --name other x\n\n'
fi
