#!/usr/bin/env bash
# A simulated docker CLI for tests/unit/deploy-script.test.ts. It answers exactly the calls
# ops/deploy.sh makes, from a state directory ($SIM), and records the calls that change something
# in $SIM/calls, one normalized line each, so a test can assert their order:
#
#   compose pull tag=<TARUBOT_IMAGE_TAG or ->        compose config tag=…
#   compose up tag=… pin=<.env pin> [orphans]        compose stop
#   compose run tag=… pin=…                          exec register | exec list
#   stop-oneoff
#
# State: $SIM/current (the tarubot service's container id), $SIM/c/<id>.json and .logs (inspect
# output and logs), $SIM/versions/<version> ("<commit> <digest> <image id>") and knobs in
# $SIM/knob/<name>: up.<version> (healthy, unstable, fail-before-lease, fail-after-lease,
# fail-no-modules, fail-no-container), pull, config, stop, migrate (ok, none, fail), register,
# list (fail), backup_running (a count of polls), oneoff, lease_after_stop, digest.<version>
# (wrong). Two knobs act from the first `up` on and are used up by it: ps_after_up (fail: ps
# fails; two: ps lists a second container; none: ps lists nothing, until the next `up`) and
# inspect_after_up (fail: the container that `up` created can't be inspected). Every call is also
# appended to $SIM/runtime as "docker <arguments>", where the Quadlet stubs log theirs, so a test
# can show that each runtime's path calls only its own tools.
set -euo pipefail
S=$SIM
printf 'docker %s\n' "$*" >>"$S/runtime"

knob() { if [[ -f $S/knob/$1 ]]; then cat "$S/knob/$1"; fi; }
record() { printf '%s\n' "$*" >>"$S/calls"; }
pin_of() { sed -n 's/^TARUBOT_IMAGE_TAG=//p' "$1/.env"; }

# Write container $1 for version $2 with state $3, health $4 and log mode $5.
container() {
  local id=$1 version=$2 status=$3 health=$4 mode=$5 commit digest image
  read -r commit digest image <"$S/versions/$version"
  jq -n --arg id "$id" --arg image "$image" --arg v "$version" --arg c "$commit" \
    --arg status "$status" --arg health "$health" \
    '[{Id: $id, Image: $image, RestartCount: 0, State: {Status: $status, Health: {Status: $health}},
       Config: {Labels: {"org.opencontainers.image.version": $v,
         "org.opencontainers.image.revision": $c, "com.docker.compose.project": "tarubot"}}}]' \
    >"$S/c/$id.json"
  : >"$S/c/$id.logs"
  case $mode in
    lease) printf '%s\n' '{"level":30,"msg":"Modules loaded"}' \
      '{"level":30,"lock":714882494,"msg":"Database writer lease acquired"}' >>"$S/c/$id.logs" ;;
    waiting) printf '%s\n' '{"level":30,"msg":"Modules loaded"}' \
      '{"level":30,"msg":"Waiting for the database writer lease held by another TaruBot writer; readiness stays false."}' \
      >>"$S/c/$id.logs" ;;
    crash) printf '%s\n' 'error: DISCORD_TOKEN is required' >>"$S/c/$id.logs" ;;
  esac
}

# A new container id for each start.
next_id() {
  local n
  n=$(($(cat "$S/counter" 2>/dev/null || printf 0) + 1))
  printf '%s\n' "$n" >"$S/counter"
  printf 'c0ffee%06x' "$n"
}

case $1 in
  info) exit 0 ;;
  inspect)
    [[ -f $S/c/$2.json && ! -f $S/c/$2.noinspect ]] || exit 1
    n=$(($(cat "$S/c/$2.inspects" 2>/dev/null || printf 0) + 1))
    printf '%s\n' "$n" >"$S/c/$2.inspects"
    # An unstable container shows a restart from its second inspection on.
    if [[ -f $S/c/$2.unstable && $n -ge 2 ]]; then
      jq '.[0].RestartCount = 1' "$S/c/$2.json"
    else
      cat "$S/c/$2.json"
    fi
    ;;
  image)
    version=${3##*:}
    [[ -f $S/versions/$version ]] || exit 1
    read -r commit digest image <"$S/versions/$version"
    if [[ $(knob "digest.$version") == wrong ]]; then digest=sha256:$(printf '0%.0s' {1..64}); fi
    jq -n --arg image "$image" --arg ref "ghcr.io/deconfined/tarubot@$digest" --arg v "$version" \
      --arg c "$commit" '[{Id: $image, RepoDigests: [$ref],
        Config: {Labels: {"org.opencontainers.image.version": $v, "org.opencontainers.image.revision": $c}}}]'
    ;;
  logs) cat "$S/c/$2.logs" ;;
  ps)
    if [[ $* == *service=backup* ]]; then
      left=$(knob backup_running)
      if ((${left:-0} > 0)); then
        printf '%s\n' "$((left - 1))" >"$S/knob/backup_running"
        printf 'ba0000000001\n'
      fi
    elif [[ $* == *oneoff=True* && -f $S/knob/oneoff ]]; then
      printf 'ba0000000002\n'
    fi
    ;;
  stop) record stop-oneoff ;;
  compose)
    shift
    project=
    while [[ $1 == -f || $1 == --project-directory ]]; do
      if [[ $1 == --project-directory ]]; then project=$2; fi
      shift 2
    done
    sub=$1
    shift
    tag=${TARUBOT_IMAGE_TAG:--}
    case $sub in
      ps)
        case $(cat "$S/ps_mode" 2>/dev/null || true) in
          fail) exit 1 ;;
          two) printf '%s\n' "$(cat "$S/current")" c0ffee999999 ;;
          none) ;;
          *) if [[ -s $S/current ]]; then cat "$S/current"; fi ;;
        esac
        ;;
      pull)
        record "compose pull tag=$tag"
        [[ $(knob pull) != fail ]]
        ;;
      config)
        record "compose config tag=$tag"
        [[ $(knob config) != fail ]]
        ;;
      stop)
        record "compose stop"
        if [[ $(knob stop) == fail ]]; then exit 1; fi
        id=$(cat "$S/current")
        jq '.[0].State.Status = "exited"' "$S/c/$id.json" >"$S/tmp.json"
        mv "$S/tmp.json" "$S/c/$id.json"
        if [[ -f $S/knob/lease_after_stop ]]; then
          printf '%s\n' '{"level":30,"msg":"Database writer lease acquired"}' >>"$S/c/$id.logs"
        fi
        ;;
      up)
        orphans=
        if [[ $* == *--remove-orphans* ]]; then orphans=" orphans"; fi
        record "compose up tag=$tag pin=$(pin_of "$project")$orphans"
        version=${TARUBOT_IMAGE_TAG:-$(pin_of "$project")}
        mode=$(knob "up.$version")
        mode=${mode:-healthy}
        # A ps mode lasts until the next up; the first up takes the knob.
        rm -f "$S/ps_mode"
        if [[ -f $S/knob/ps_after_up ]]; then mv "$S/knob/ps_after_up" "$S/ps_mode"; fi
        if [[ $mode == fail-no-container ]]; then exit 1; fi
        id=$(next_id)
        if [[ -f $S/knob/inspect_after_up ]]; then
          rm -f "$S/knob/inspect_after_up"
          : >"$S/c/$id.noinspect"
        fi
        case $mode in
          healthy) container "$id" "$version" running healthy lease ;;
          unstable)
            container "$id" "$version" running healthy lease
            : >"$S/c/$id.unstable"
            ;;
          fail-before-lease) container "$id" "$version" running unhealthy waiting ;;
          fail-after-lease) container "$id" "$version" restarting unhealthy lease ;;
          fail-no-modules) container "$id" "$version" restarting unhealthy crash ;;
        esac
        printf '%s\n' "$id" >"$S/current"
        [[ $mode == healthy || $mode == unstable ]]
        ;;
      run)
        record "compose run tag=$tag pin=$(pin_of "$project")"
        case $(knob migrate) in
          fail)
            printf 'A TaruBot writer holds the writer lease, so 1 pending migration(s) were not applied.\n'
            exit 1
            ;;
          none) printf 'Schema ready.\n' ;;
          *)
            printf 'Migration writer lease acquired at 2026-09-29 19:30:05.123456+00; applied 002_more.sql; committing at 2026-09-29 19:30:06.2+00.\n'
            printf 'Schema ready.\n'
            ;;
        esac
        ;;
      exec)
        if [[ $* == *register.js* ]]; then
          record "exec register"
          [[ $(knob register) != fail ]]
        else
          record "exec list"
          if [[ $(knob list) == fail ]]; then exit 2; fi
        fi
        ;;
      *) exit 1 ;;
    esac
    ;;
  *) exit 1 ;;
esac
