#!/usr/bin/env bash
# A simulated podman CLI for tests/unit/deploy-script.test.ts, over the host in
# tests/fixtures/deploy-stubs/sim.sh. It answers exactly the calls ops/deploy.sh's Quadlet path
# makes, in the shapes Podman 5.8.2 gives (tests/fixtures/deploy-podman), and records the calls
# that change something in $SIM/calls:
#
#   podman pull <release>       exec register --global | exec register --guild | exec list
#   stop-oneoff
#
# Knobs ($SIM/knob/<name>): podman_info (fail), event_logger (a logger other than journald), pull
# (fail), digest.<release> (wrong: the pulled image lacks the digest), ps_unit (fail, two),
# backup_running (a count of polls that list the dump), oneoff (a migrate.js container runs),
# register and list (fail), events (fail, garbage) and inspect_live (fail).
set -euo pipefail
# shellcheck source=tests/fixtures/deploy-stubs/sim.sh
source "$DEPLOY_STUBS/sim.sh"
trace podman "$@"

# Podman's `image inspect` answer for release $1, from the captured one: RepoDigests holds the
# index digest it was pulled by and the platform manifest's, as a pull by index digest leaves it.
image_json() {
  local commit digest image platform
  read -r commit digest image <"$S/versions/$1"
  if [[ $(knob "digest.$1") == wrong ]]; then digest=sha256:$(printf '0%.0s' {1..64}); fi
  platform=sha256:$(printf 'platform %s' "$1" | sha256sum | cut -c1-64)
  jq --arg id "${image#sha256:}" --arg digest "$digest" --arg platform "$platform" --arg v "$1" \
    --arg c "$commit" '
      .[0].Id = $id | .[0].Digest = $digest
      | .[0].RepoDigests = ["ghcr.io/deconfined/tarubot@" + $digest,
          "ghcr.io/deconfined/tarubot@" + $platform]
      | .[0].Config.Labels["org.opencontainers.image.version"] = $v
      | .[0].Config.Labels["org.opencontainers.image.revision"] = $c
      | .[0].Labels = .[0].Config.Labels' "$PODMAN_FIXTURES/image.json"
}

case $1 in
  info)
    [[ $(knob podman_info) != fail ]] || exit 125
    case ${3-} in
      '{{.Host.EventLogger}}') printf '%s\n' "$(knob event_logger | grep . || printf journald)" ;;
      '{{.Store.GraphRoot}}') printf '%s\n' "$S/graph" ;;
      *) exit 125 ;;
    esac
    ;;
  pull)
    ref=${*: -1}
    version=$(version_of "${ref#ghcr.io/deconfined/tarubot@}")
    record "podman pull ${version:-?}"
    [[ $(knob pull) != fail && -n $version ]] || exit 125
    printf '%s\n' "$(read -r _ _ image <"$S/versions/$version" && printf '%s' "${image#sha256:}")"
    ;;
  image)
    [[ $2 == inspect ]] || exit 125
    ref=$3
    version=$(version_of "${ref#ghcr.io/deconfined/tarubot@}")
    [[ $ref == ghcr.io/deconfined/tarubot@sha256:* && -n $version ]] || exit 125
    image_json "$version"
    ;;
  container)
    [[ $2 == inspect ]] || exit 125
    id=$3
    if [[ $id == tarubot ]]; then id=$(cat "$S/current" 2>/dev/null || true); fi
    [[ -n $id && -f $S/c/$id.json ]] || exit 125
    if [[ $(knob inspect_live) == fail && $id == $(cat "$S/live") ]]; then exit 125; fi
    cat "$S/c/$id.json"
    ;;
  ps)
    case "$*" in
      *label=PODMAN_SYSTEMD_UNIT=tarubot.service*)
        case $(knob ps_unit) in
          fail) exit 125 ;;
          two) printf '%s\n' "$(cat "$S/current")" "c0ffee$(printf '9%.0s' {1..58})" ;;
          *)
            id=$(cat "$S/current" 2>/dev/null || true)
            if [[ -n $id && -f $S/c/$id.json ]]; then printf '%s\n' "$id"; fi
            ;;
        esac
        ;;
      *label=io.tarubot.role=backup*)
        left=$(knob backup_running)
        if ((${left:-0} > 0)); then
          printf '%s\n' "$((left - 1))" >"$S/knob/backup_running"
          printf 'ba0000000001\n'
        fi
        ;;
      *label=io.tarubot.role=tool*)
        if [[ -f $S/knob/oneoff ]]; then printf 'ba0000000002\n'; fi
        ;;
      *) exit 125 ;;
    esac
    ;;
  stop) record stop-oneoff ;;
  exec)
    [[ $2 == tarubot ]] || exit 125
    shift 2
    case "$*" in
      'bun dist/scripts/register.js --global')
        record "exec register --global"
        [[ $(knob register) != fail ]]
        ;;
      'sh -c exec bun dist/scripts/register.js --guild "$TEST_GUILD_ID"')
        record "exec register --guild"
        [[ $(knob register) != fail ]]
        ;;
      'bun dist/scripts/commands.js list')
        record "exec list"
        if [[ $(knob list) == fail ]]; then exit 2; fi
        ;;
      *)
        record "exec ?"
        exit 125
        ;;
    esac
    ;;
  events)
    case $(knob events) in
      fail) exit 125 ;;
      garbage)
        printf 'not an event\n'
        exit 0
        ;;
    esac
    # --since, and the container and event filters, as Podman applies them.
    since='' names=() statuses=()
    shift
    while (($#)); do
      case $1 in
        --since)
          since=$(date -u -d "$2" +%s%N) || exit 125
          shift
          ;;
        --filter)
          case $2 in
            container=*) names+=("${2#container=}") ;;
            event=*) statuses+=("${2#event=}") ;;
          esac
          shift
          ;;
      esac
      shift
    done
    [[ -f $S/events ]] || exit 0
    jq -c --argjson since "${since:-0}" --arg names "${names[*]}" --arg statuses "${statuses[*]}" '
        ($names | split(" ") | map(select(. != ""))) as $n
        | ($statuses | split(" ") | map(select(. != ""))) as $st
        | select(.timeNano >= $since)
        | select(($n | length) == 0 or (.Name as $x | .ID as $i | any($n[]; . == $x or . == $i)))
        | select(($st | length) == 0 or (.Status as $s | any($st[]; . == $s)))' <"$S/events"
    ;;
  *) exit 125 ;;
esac
