#!/usr/bin/env bash
# A simulated ansible-playbook for tests/unit/host-config.test.ts, run by tarubot-host-config under
# env -i: it finds the scenario from its own place (<sandbox>/bin reads <sandbox>/sim) and the
# sandbox's paths from sim/paths (KEY=value lines: CLONE, HOME_DIR, SETTINGS, SIGNERS, LOCK,
# MARKER).
#
# It refuses (exit 5) unless the call is exactly the pull unit's: the environment (a UTF-8 locale,
# the clone's ansible.cfg, the sandbox HOME and Ansible temp paths, PYTHONNOUSERSITE, and not
# HC_CANARY), umask 0022, fds 8 and 9 closed, the clone's ops/ansible as the working directory, the
# argv of the spec's section 13 with a valid source, commit and run id, tarubot_pull_role equal to
# host.yml's role, tarubot_pull_signers equal to the sha256 of host.yml's signers ("<type> <key>"
# joined by commas, as the playbook computes it) and no start variable, and the host lock really
# held by someone (flock -n fails). Then, as the playbook would, it renders the allowed signers
# from host.yml and writes the run marker, and prints a PLAY RECAP.
# Every accepted call goes to sim/playbook-calls ("<source> <commit> <run>"); sim/play-started
# appears as it starts.
#
# Knobs in sim/knob: play-changed (the recap's changed count), play-sleep (seconds, before
# anything is written), play-fail (a task name: print it with fatal: and exit 2, after the
# marker), play-fail-early (the same before the marker and the signers file, as a pre_tasks
# assert fails), play-nomarker and play-badmarker.
set -euo pipefail
sim=$(cd "$(dirname "$0")/../sim" && pwd)
knob=$sim/knob
refuse() {
  printf 'ansible-playbook stub: %s\n' "$*" >&2
  exit 5
}
while IFS='=' read -r key value; do
  case $key in
    CLONE) clone=$value ;;
    HOME_DIR) home=$value ;;
    SETTINGS) settings=$value ;;
    SIGNERS) signers=$value ;;
    LOCK) lock=$value ;;
    MARKER) marker=$value ;;
  esac
done <"$sim/paths"

[[ ${LC_ALL-} == C.UTF-8 && ${LANG-} == C.UTF-8 ]] || refuse "locale ${LC_ALL-}"
[[ ${ANSIBLE_CONFIG-} == "$clone/ops/ansible/ansible.cfg" ]] || refuse "ANSIBLE_CONFIG ${ANSIBLE_CONFIG-}"
[[ ${HOME-} == "$home" ]] || refuse "HOME ${HOME-}"
[[ ${PYTHONNOUSERSITE-} == 1 ]] || refuse PYTHONNOUSERSITE
[[ ${ANSIBLE_HOME-} == "$home/.ansible" && ${ANSIBLE_LOCAL_TEMP-} == "$home/.ansible/tmp" ]] || refuse ANSIBLE_HOME
[[ ${ANSIBLE_REMOTE_TMP-} == "$home/.ansible/tmp" ]] || refuse "ANSIBLE_REMOTE_TMP ${ANSIBLE_REMOTE_TMP-}"
[[ -z ${HC_CANARY-} ]] || refuse "the caller environment reached the playbook"
[[ $(umask) == 0022 ]] || refuse "umask $(umask)"
[[ ! -e /proc/$$/fd/8 && ! -e /proc/$$/fd/9 ]] || refuse "a lock descriptor is open"
[[ $PWD == "$clone/ops/ansible" ]] || refuse "working directory $PWD"

role=$(sed -n "s/^tarubot_role:[[:space:]]*[\"']\{0,1\}\([a-z]*\).*/\1/p" "$settings")
# host.yml's signers, "<type> <key>" each, in order: the block list's quoted items.
keys=()
inside=0
while IFS= read -r line; do
  if [[ $line == tarubot_allowed_signers:* ]]; then
    inside=1
    continue
  fi
  ((inside)) || continue
  if [[ $line =~ ^[[:space:]]+-[[:space:]]+[\"\']([a-z0-9@.-]+)\ ([A-Za-z0-9+/=]+)( [^\"\']*)?[\"\'] ]]; then
    keys+=("${BASH_REMATCH[1]} ${BASH_REMATCH[2]}")
  elif [[ -n $line && $line != ' '* ]]; then
    inside=0
  fi
done <"$settings"
digest=$(
  IFS=,
  printf '%s' "${keys[*]}" | sha256sum
)
digest=${digest%% *}
argv=("$@")
expected=(-c local -i 'localhost,' "$clone/ops/ansible/site.yml" -e "@$settings" -e tarubot_host_lock_held=true
  -e SOURCE -e COMMIT -e RUN -e "tarubot_pull_role=$role" -e "tarubot_pull_signers=$digest" --skip-tags start --diff)
(($# == ${#expected[@]})) || refuse "argv $*"
for ((i = 0; i < $#; i++)); do
  case ${expected[i]} in
    SOURCE) [[ ${argv[i]} =~ ^tarubot_source=(pull|bootstrap|emergency)$ ]] || refuse "source ${argv[i]}" ;;
    COMMIT) [[ ${argv[i]} =~ ^tarubot_commit=[0-9a-f]{40}$ ]] || refuse "commit ${argv[i]}" ;;
    RUN) [[ ${argv[i]} =~ ^tarubot_run=[0-9a-f]{16}$ ]] || refuse "run ${argv[i]}" ;;
    *) [[ ${argv[i]} == "${expected[i]}" ]] || refuse "argument $((i + 1)): ${argv[i]}" ;;
  esac
done
[[ -n $role ]] || refuse "no role in host.yml"
[[ $* != *tarubot_start* ]] || refuse "a start variable"
source=${argv[10]#tarubot_source=} commit=${argv[12]#tarubot_commit=} run=${argv[14]#tarubot_run=}
if flock -n "$lock" true; then refuse "the host lock is free"; fi

printf '%s %s %s\n' "$source" "$commit" "$run" >>"$sim/playbook-calls"
: >"$sim/play-started"
if [[ -f $knob/play-sleep ]]; then sleep "$(cat "$knob/play-sleep")"; fi

if [[ -f $knob/play-fail-early ]]; then
  printf '\nTASK [%s] ***\nfatal: [localhost]: FAILED! => {"changed": false, "msg": "simulated"}\n' "$(cat "$knob/play-fail-early")"
  printf '\nPLAY RECAP ***\nlocalhost : ok=3 changed=0 unreachable=0 failed=1 skipped=0 rescued=0 ignored=0\n'
  exit 2
fi

# The allowed signers, rendered from host.yml's tarubot_allowed_signers.
{
  printf '# Rendered from host settings.\n'
  for key in "${keys[@]}"; do printf 'deconfined namespaces="git" %s\n' "$key"; done
} >"$signers.tmp"
chmod 644 "$signers.tmp"
mv -f "$signers.tmp" "$signers"

if [[ ! -f $knob/play-nomarker ]]; then
  if [[ -f $knob/play-badmarker ]]; then run=0000000000000000; fi
  printf '{"source":"%s","commit":"%s","run":"%s"}\n' "$source" "$commit" "$run" >"$marker.tmp"
  chmod 600 "$marker.tmp"
  mv -f "$marker.tmp" "$marker"
fi

printf '\nPLAY [Configure the host as root] ***\n\nTASK [Gathering Facts] ***\nok: [localhost]\n'
if [[ -f $knob/play-fail ]]; then
  printf '\nTASK [%s] ***\nfatal: [localhost]: FAILED! => {"changed": false, "msg": "simulated"}\n' "$(cat "$knob/play-fail")"
  printf '\nPLAY RECAP ***\nlocalhost : ok=3 changed=1 unreachable=0 failed=1 skipped=0 rescued=0 ignored=0\n'
  exit 2
fi
changed=0
if [[ -f $knob/play-changed ]]; then changed=$(cat "$knob/play-changed"); fi
printf '\nPLAY RECAP ***\nlocalhost : ok=40 changed=%s unreachable=0 failed=0 skipped=5 rescued=0 ignored=0\n' "$changed"
