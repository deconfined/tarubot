#!/usr/bin/env bash
# A simulated gh for the plan job in tests/unit/deploy-workflow.test.ts.
#
# `gh api [-H …] PATH [--jq FILTER]` answers from $STUB/api/<PATH with / ? = as _>, filtered
# through jq like gh; a missing file is GitHub's 404. Each PATH is recorded in $STUB/api-calls, so
# the tests can show what the plan asks GitHub (never an environment's settings).
#
# `gh attestation verify oci://IMAGE@DIGEST … --source-digest COMMIT … --format json` appends its
# arguments to $STUB/attest-calls (a `call` line, then one argument per line) and answers like gh:
# with $STUB/attested/<DIGEST> holding the commit the image was signed for, a matching
# --source-digest prints $STUB/attest-answer (one verified result by default) and exits 0, and a
# different one fails as gh does. No file is gh's 404 for an image that carries no attestation.
#
# The signer: $STUB/signer holds the certificate's identity (its SAN), main's publish.yml by
# default. As in gh 2.101, --cert-identity must equal it, while --signer-workflow W (and --repo
# alone) only has to start it: gh anchors that pattern at its start alone, so a workflow named
# publish.yml-canary.yml passes --signer-workflow …/publish.yml.
set -euo pipefail
if [[ $1 == attestation ]]; then
  [[ $2 == verify ]] || exit 1
  {
    printf 'call\n'
    printf '%s\n' "$@"
  } >>"$STUB/attest-calls"
  subject=$3 source='' identity='' prefix=https://github.com/deconfined/tarubot/
  shift 3
  while (($#)); do
    case $1 in
      --source-digest) source=$2; shift 2 ;;
      --cert-identity) identity=$2; shift 2 ;;
      --signer-workflow) prefix=https://github.com/$2; shift 2 ;;
      *) shift ;;
    esac
  done
  digest=${subject##*@}
  if [[ ! -f $STUB/attested/$digest ]]; then
    printf 'Error: HTTP 404: Not Found (https://api.github.com/repos/deconfined/tarubot/attestations/%s)\n' "$digest" >&2
    exit 1
  fi
  signed=$(cat "$STUB/attested/$digest")
  if [[ $source != "$signed" ]]; then
    printf 'Error: expected SourceRepositoryDigest to be %s, got %s\n' "$source" "$signed" >&2
    exit 1
  fi
  san=https://github.com/deconfined/tarubot/.github/workflows/publish.yml@refs/heads/main
  if [[ -f $STUB/signer ]]; then san=$(cat "$STUB/signer"); fi
  if [[ -n $identity && $san != "$identity" ]] || [[ -z $identity && $san != "$prefix"* ]]; then
    printf 'Error: verifying with issuer "sigstore.dev": expected SubjectAlternativeName to match %s, got %s\n' "${identity:-$prefix}" "$san" >&2
    exit 1
  fi
  if [[ -f $STUB/attest-answer ]]; then
    cat "$STUB/attest-answer"
  else
    printf '[{"verificationResult":{"statement":{"predicateType":"https://slsa.dev/provenance/v1"}}}]\n'
  fi
  exit 0
fi
[[ $1 == api ]] || exit 1
shift
path='' filter=''
while (($#)); do
  case $1 in
    -H) shift 2 ;;
    --jq) filter=$2; shift 2 ;;
    *) path=$1; shift ;;
  esac
done
printf '%s\n' "$path" >>"$STUB/api-calls"
file=$STUB/api/$(printf '%s' "$path" | tr '/?=' '___')
if [[ ! -f $file ]]; then
  printf 'gh: Not Found (HTTP 404) %s\n' "$path" >&2
  exit 1
fi
if [[ -n $filter ]]; then jq -r "$filter" "$file"; else cat "$file"; fi
