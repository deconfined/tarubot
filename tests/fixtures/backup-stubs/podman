#!/usr/bin/env bash
# Stand-in for podman in tests/unit/backup-quadlet.test.ts (ops/ansible/files/bot/tarubot-backup)
# and tests/unit/bot-play.test.ts (tarubot-tool). It records the call and what its stdin held
# (stdin: "eof", "data", or "open" for a pipe that stayed silent), then:
# - `secret inspect --showsecret --format ... tarubot-NAME` prints $BACKUP_SIM/secrets/NAME's text
#   and a newline, as Podman prints SecretData, or fails as a missing secret does;
# - `run` exits with the number in $BACKUP_SIM/knob/podman-exit when it exists (tarubot-tool's
#   pass-through); otherwise it writes a dummy dump larger than the backup's size guard (a small
#   one when $BACKUP_SIM/knob/small exists), or fails as pg_dump would when $BACKUP_SIM/knob/podman
#   exists.
set -euo pipefail
# shellcheck source=tests/fixtures/backup-stubs/record.sh
. "$(dirname "$(readlink -f "$0")")/record.sh"
record podman "$@"
# read's status: 0 when a byte came, 1 at end of file, above 128 when the wait ran out.
stdin=eof
if IFS= read -r -n 1 -t 2 _; then
  stdin=data
elif (($? > 128)); then
  stdin=open
fi
printf '%s' "$stdin" >"$call/stdin"
if [[ ${1-} == secret && ${2-} == inspect ]]; then
  name=${!#}
  file="$BACKUP_SIM/secrets/${name#tarubot-}"
  if [[ ! -f $file ]]; then
    echo "Error: $name: no such secret" >&2
    exit 125
  fi
  cat -- "$file"
  echo
  exit 0
fi
if [[ ${1-} == run ]]; then
  if [[ -f $BACKUP_SIM/knob/podman-exit ]]; then
    exit "$(<"$BACKUP_SIM/knob/podman-exit")"
  fi
  if [[ -f $BACKUP_SIM/knob/podman ]]; then
    echo 'pg_dump: error: the stand-in failed' >&2
    exit 1
  fi
  # A dump too small to be real when $BACKUP_SIM/knob/small exists.
  if [[ -f $BACKUP_SIM/knob/small ]]; then
    head -c 100 /dev/zero | tr '\0' P
    exit 0
  fi
  head -c 8192 /dev/zero | tr '\0' P
fi
