#!/usr/bin/env bash
# Stand-in for `age --encrypt --recipients-file FILE --output OUT [INPUT]` in
# tests/unit/backup-quadlet.test.ts: it records the call and copies the input (stdin when none is
# named) to OUT as it is, so the size guard sees the dump's size.
set -euo pipefail
# shellcheck source=tests/fixtures/backup-stubs/record.sh
. "$(dirname "$(readlink -f "$0")")/record.sh"
record age "$@"
out='' input=-
while (($#)); do
  case $1 in
    --output) out=$2 && shift ;;
    --recipients-file) shift ;;
    --encrypt) ;;
    *) input=$1 ;;
  esac
  shift
done
if [[ $input == - ]]; then cat >"$out"; else cat -- "$input" >"$out"; fi
