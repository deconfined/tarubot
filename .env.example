# Maintenance-tool deployment profile: production, rehearsal, staging, devbot, or empty to infer it
# (DevBot's application ID infers devbot; only the marker selects staging). Production and rehearsal
# runs use a copy of production.env.example passed with bun --env-file, never this file, and the
# staging host uses staging.env.example. See docs/CONFIGURATION.md.
TARUBOT_ENVIRONMENT=
# The secrets below (DATABASE_URL, DATABASE_CA_CERT, DISCORD_TOKEN, GITHUB_REPORTS_TOKEN and
# HEALTHCHECKS_PING_URL) may instead come from a file: NAME_FILE names it, and the value is its text
# less one final newline. Set NAME or NAME_FILE, never both.
# Use a URL-safe password or percent-encode it in DATABASE_URL.
POSTGRES_PASSWORD=local-development-password
# The devbot tool profile refuses any database but .../tarubot_dev (DevBot itself runs on staging).
DATABASE_URL=postgresql://tarubot:local-development-password@localhost:5432/tarubot
# Optional PEM root CA for a hosted PostgreSQL endpoint. With a CA set, certificate and hostname
# verification are enforced over URL SSL flags; tools connect as the application's database user.
DATABASE_CA_CERT=
# Optional CA for RESTORE_DATABASE_URL, the target of a restore or restore check (restore.js,
# check-restore.js); empty reuses DATABASE_CA_CERT.
RESTORE_DATABASE_CA_CERT=
# Registry deployment defaults to latest; use a published SemVer to pin a release. The web
# profile's proxy runs the same release's web-<tag> image; sha-COMMIT tags exist for the bot only.
# Both images come from ghcr.io/deconfined/tarubot unless TARUBOT_IMAGE_REPOSITORY names another
# repository that carries the same tags.
TARUBOT_IMAGE_TAG=latest
# Optional full bot-image override, which also supports immutable @sha256 digests.
TARUBOT_IMAGE=
# Discord identity for the selected development or production application.
DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
# Startup command registration (2.46.0) for a self-hosted (unmanaged) install; production, staging
# and DevBot always register in their own scope. The bot registers its commands each time it
# starts, in this scope: global, one server's ID (an install that used register.js --guild), or off
# (empty is off, for an install that registers by hand with register.js). global is refused while
# TEST_GUILD_ID is set; use that server's ID instead. A problem is reported, never fatal.
COMMAND_REGISTRATION=global
# Optional HTTPS dashboard. Set the canonical origin and the same application's OAuth secret.
# Register WEB_PUBLIC_ORIGIN/auth/callback in Discord, then set COMPOSE_PROFILES=web for Caddy.
# Leave the origin/profile empty for bot-only operation; WEB_PORT stays private to Compose.
WEB_PUBLIC_ORIGIN=
WEB_PORT=8080
DISCORD_CLIENT_SECRET=
COMPOSE_PROFILES=
# A value scopes development interactions/events to one guild; empty is normal scope.
TEST_GUILD_ID=
# When true, all new command/component replies in TEST_GUILD_ID are public.
# The DevBot Compose overlay enables this by default for observed test sessions.
PUBLIC_TEST_RESPONSES=false
# Development startup announcement; empty channel ID resolves #chat in TEST_GUILD_ID.
TEST_PLAN_CHANNEL_ID=
TEST_PLAN_FILE=test-plans/current.json
LOG_LEVEL=info
# Process-wide delivery switch, separate from each imported guild's activation flag.
ENABLE_EFFECTS=false
# How often each tracked FC roster is read, in seconds.
ROSTER_INTERVAL_SECONDS=21600
# Proof expiry and denied-application cooldown are policy settings, in seconds.
VERIFICATION_SECONDS=1800
GUEST_COOLDOWN_SECONDS=86400
# Local liveness/readiness endpoint; probes never acquire Lodestone pages.
HEALTH_PORT=3000
# The Lodestone parser runs in the bot (2.21.0: no sidecar). The regional Lodestone it reads, its
# parses at once, actual request spacing, fetch deadline, and streamed body bound.
LODESTONE_REGION=na
LODESTONE_CONCURRENCY=2
LODESTONE_START_MS=1000
LODESTONE_TIMEOUT_MS=15000
LODESTONE_BODY_BYTES=2000000
# Retries share the overall job deadline and bounded pagination.
LODESTONE_REQUEST_TIMEOUT_MS=35000
LODESTONE_JOB_TIMEOUT_MS=300000
LODESTONE_ATTEMPTS=3
LODESTONE_MAX_PAGES=100
# Issue reports (2.18.0): a fine-grained token limited to the reports repository's issues.
# Empty keeps /issue and automatic reports in the database until a token is set.
GITHUB_REPORTS_TOKEN=
GITHUB_REPORTS_REPO=deconfined/tarubot-reports
# Heartbeat (2.22.0): a healthchecks.io ping URL (https://hc-ping.com/…), pinged every five minutes
# while the bot is ready, so the check alerts when pings stop. Keep it private; empty turns it off.
HEALTHCHECKS_PING_URL=
# Check xivapi/lodestone-css-selectors every 15 minutes; a new HEAD goes live on its own (2.19.0).
# 0 keeps the set bundled with the release.
LODESTONE_SELECTOR_CHECK_SECONDS=900
# Mod mail (2.43.0): base64 for 32 bytes, from openssl rand -base64 32. It encrypts every case; keep
# a copy off the host, since losing it loses every case. Empty leaves mod mail unavailable.
MODMAIL_KEY=
# Optional backups (2.46.0): the bot takes one daily at BACKUP_TIME_UTC (UTC, HH:MM) and one before
# it applies migrations, encrypted for BACKUP_AGE_RECIPIENTS (age public keys), into an HTTPS
# S3-compatible bucket: its virtual-hosted endpoint (an optional path is a key prefix), credentials
# and signing region. An empty endpoint turns backups off. HEALTHCHECKS_BACKUP_URL is an optional
# healthchecks.io check for them.
BACKUP_STORAGE_ENDPOINT=
BACKUP_STORAGE_ACCESS_KEY=
BACKUP_STORAGE_SECRET_KEY=
BACKUP_STORAGE_REGION=
BACKUP_AGE_RECIPIENTS=
BACKUP_TIME_UTC=03:00
HEALTHCHECKS_BACKUP_URL=
