# Staging-only settings for docker-compose.staging.yml. Keep a private copy (mode 600) wherever
# you run Compose against staging's own Docker host, replace every placeholder, and pass it as
# the project's environment:
#   docker compose --env-file <copy> -f docker-compose.staging.yml up -d
# Never reuse production credentials or its Docker host. The release is the `staging` tag, which
# the approved Deploy workflow moves and Watchtower follows; run `up -d` again after a change.
TARUBOT_ENVIRONMENT=staging
TARUBOT_IMAGE_TAG=staging
# Direct managed connection (not the transaction pool), verified with this CA.
DATABASE_URL=postgresql://tarubot_staging:REPLACE_WITH_STAGING_DATABASE_PASSWORD@REPLACE_WITH_DATABASE_HOST:27520/tarubot_staging
DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----
REPLACE_WITH_DATABASE_CA_CERTIFICATE
-----END CERTIFICATE-----"
DISCORD_TOKEN=REPLACE_WITH_STAGING_BOT_TOKEN
# Must match staging's application and declared test guild in src/config/deployment.ts.
DISCORD_APPLICATION_ID=REPLACE_WITH_STAGING_APPLICATION_ID
TEST_GUILD_ID=REPLACE_WITH_STAGING_TEST_GUILD_ID
# Optional dashboard: https://staging.tarubot.example.org and the staging OAuth client secret.
# Register that origin's /auth/callback in Discord. COMPOSE_PROFILES=web enables bundled Caddy.
WEB_PUBLIC_ORIGIN=
WEB_PORT=8080
DISCORD_CLIENT_SECRET=
COMPOSE_PROFILES=
ENABLE_EFFECTS=false
PUBLIC_TEST_RESPONSES=false
TEST_PLAN_CHANNEL_ID=
TEST_PLAN_FILE=test-plans/current.json
LOG_LEVEL=info
ROSTER_INTERVAL_SECONDS=21600
VERIFICATION_SECONDS=1800
GUEST_COOLDOWN_SECONDS=86400
LODESTONE_REGION=na
LODESTONE_CONCURRENCY=2
LODESTONE_START_MS=1000
LODESTONE_TIMEOUT_MS=15000
LODESTONE_BODY_BYTES=2000000
LODESTONE_REQUEST_TIMEOUT_MS=35000
LODESTONE_JOB_TIMEOUT_MS=300000
LODESTONE_ATTEMPTS=3
LODESTONE_MAX_PAGES=100
LODESTONE_SELECTOR_CHECK_SECONDS=900
# Optional staging-only report token and heartbeat; no production suggestion App.
GITHUB_REPORTS_TOKEN=
GITHUB_REPORTS_REPO=deconfined/tarubot-reports
HEALTHCHECKS_PING_URL=
# Optional mod mail key, staging's own (openssl rand -base64 32); keep a copy offline.
MODMAIL_KEY=
# Backups (2.46.0) into staging's own bucket, which uses daily/, monthly/ and env/ object keys just
# like production; staging refuses to migrate without them. Never production's bucket or key.
BACKUP_STORAGE_ENDPOINT=REPLACE_WITH_STAGING_HTTPS_BUCKET_HOST
BACKUP_STORAGE_ACCESS_KEY=REPLACE_WITH_STAGING_BACKUP_ACCESS_KEY
BACKUP_STORAGE_SECRET_KEY=REPLACE_WITH_STAGING_BACKUP_SECRET_KEY
BACKUP_STORAGE_REGION=REPLACE_WITH_BUCKET_SIGNING_REGION
# Staging's own age public key (age1...); its private key stays with the owner.
BACKUP_AGE_RECIPIENTS=REPLACE_WITH_STAGING_AGE_PUBLIC_KEY
BACKUP_TIME_UTC=03:00
HEALTHCHECKS_BACKUP_URL=
