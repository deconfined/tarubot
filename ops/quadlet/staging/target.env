# Staging's settings on a Quadlet host (#50), in Podman's env-file format (see
# units/tarubot.env). Podman reads this file after units/tarubot.env, through this directory's
# tarubot.container.d/50-target.conf. It lists production/target.env's names, and only these
# values differ from production's.

# DevBot's application, scoped to its test guild, under the staging tool-guard profile.
DISCORD_APPLICATION_ID=943291473477128243
TARUBOT_ENVIRONMENT=staging
TEST_GUILD_ID=1040379370159743139
# Observers see replies in the test guild, as under DevBot's Compose overlay.
PUBLIC_TEST_RESPONSES=true
# The channel for the startup test plan comes from .env; unset, the bot looks for #chat.
TEST_PLAN_CHANNEL_ID
# /suggest stays off on staging, whatever .env holds: it posts publicly, and staging runs PR code.
GITHUB_APP_CLIENT_ID=
# Staging never mounts the app's key; an empty NAME_FILE counts as unset, so the bot reads none.
GITHUB_APP_PRIVATE_KEY_FILE=
