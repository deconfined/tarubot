# Production's settings on a Quadlet host (#50), in Podman's env-file format (see
# units/tarubot.env). Podman reads this file after units/tarubot.env, through this directory's
# tarubot.container.d/50-target.conf. staging/target.env lists the same names.

# The production application, and the profile maintenance tools resolve inside its container.
DISCORD_APPLICATION_ID=965294750741692416
TARUBOT_ENVIRONMENT=production
# Production never carries development scoping.
TEST_GUILD_ID=
PUBLIC_TEST_RESPONSES=false
TEST_PLAN_CHANNEL_ID=
# Public suggestions (2.28.0) post as the TaruBot GitHub App, in production only. The client ID
# isn't secret and comes from .env; empty or unset switches /suggest off.
GITHUB_APP_CLIENT_ID
# The app's private key, mounted by this directory's drop-in (a lone newline, read as empty, when
# .env has none, which also switches /suggest off).
GITHUB_APP_PRIVATE_KEY_FILE=/run/secrets/github_app_private_key
