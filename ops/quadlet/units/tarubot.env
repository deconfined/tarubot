# The settings the bot's container gets on every Quadlet host (#50), in Podman's env-file format:
# one NAME=value (a fixed value) or a bare NAME (the value systemd read from ~/tarubot/.env, passed
# only when it is set) per line. Podman reads each line literally, so there are no quotes, no
# inline comments and no NAME* lines (Podman would pass every variable with that prefix).
# The host's target.env comes after this file and holds the names that differ between production
# and staging. tests/unit/quadlet.test.ts keeps both lists in step with the bot's environment in
# docker-compose.production.yml.
#
# No secret is listed: they reach the bot as Podman secrets mounted as files (2.33.0,
# ops/quadlet/README.md "Secrets"), and the unit unsets them before Podman starts. These fixed
# NAME_FILE lines tell the bot where each file is; src/config/secrets.ts reads it and removes the
# one newline secrets.sh adds. The GitHub App key's line is in each target's list: production mounts
# the key, staging never does.
DATABASE_URL_FILE=/run/secrets/database_url
DATABASE_CA_CERT_FILE=/run/secrets/database_ca_cert
DISCORD_TOKEN_FILE=/run/secrets/discord_token
GITHUB_REPORTS_TOKEN_FILE=/run/secrets/github_reports_token
HEALTHCHECKS_PING_URL_FILE=/run/secrets/healthchecks_ping_url

# Fixed on every host, as in docker-compose.production.yml.
HEALTH_PORT=3000
ENABLE_EFFECTS=true

# Optional. Unset, the bot uses its own default, which equals Compose's. Set, the value must not be
# empty (check-env.sh), because Compose used the default for an empty value too.
LOG_LEVEL
ROSTER_INTERVAL_SECONDS
PROFILE_INTERVAL_SECONDS
VERIFICATION_SECONDS
GUEST_COOLDOWN_SECONDS
LODESTONE_REGION
LODESTONE_CONCURRENCY
LODESTONE_START_MS
LODESTONE_TIMEOUT_MS
LODESTONE_BODY_BYTES
LODESTONE_REQUEST_TIMEOUT_MS
LODESTONE_JOB_TIMEOUT_MS
LODESTONE_ATTEMPTS
LODESTONE_MAX_PAGES
LODESTONE_SELECTOR_CHECK_SECONDS
GITHUB_REPORTS_REPO
