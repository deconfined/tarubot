// Installed by TaruBot's host playbook as /etc/polkit-1/rules.d/10-tarubot.rules (#62).
//
// cloud-init may give root a console password (an optional hash in the host's user data), for the
// provider's console only. sshd refuses passwords, and pam_wheel keeps `su` to the wheel group,
// which has no members here. This rule closes the other door: polkit, which pkexec and run0 ask
// before they act for another user, answers "no" at once to every subject but root, without a
// password prompt. That covers the tarubot account and its subordinate UIDs (a process escaping
// the bot's container), and any account added later.
//
// These hosts have no other human account (cloud-init's users: [], sshd's AllowUsers root), and
// no service running as another user needs polkit. Root itself passes on to polkit's defaults,
// and systemd and logind don't ask polkit for root at all.
//
// EL10's polkit runs rules in Duktape, an ES5 engine, so the rule uses no later syntax (no arrow
// functions, let or const). tests/unit/playbook.test.ts runs it against stub subjects.
polkit.addRule(function (action, subject) {
  if (subject.user !== "root") {
    return polkit.Result.NO;
  }
});
