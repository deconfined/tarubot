# Installed by TaruBot's host playbook (#50). network-online.target waits for this oneshot, so the
# Quadlet unit, which starts after that target, sees the host's IPv6 at its first start. The script
# waits at most 60 seconds and always succeeds.
[Unit]
Description=Wait for IPv6 before network-online.target (TaruBot)
Documentation=https://github.com/deconfined/tarubot/tree/main/ops/ansible
# Like systemd-networkd-wait-online.service: ordered by hand, so nothing early in boot waits on it.
DefaultDependencies=no
After=network.target NetworkManager.service
Before=network-online.target shutdown.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/tarubot-ipv6-online
TimeoutStartSec=90

[Install]
WantedBy=network-online.target
