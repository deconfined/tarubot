#!/bin/sh
# Installed by TaruBot's host playbook as /usr/local/sbin/tarubot-ipv6-online and run once at boot
# by tarubot-ipv6-online.service, which network-online.target waits for (#50).
#
# Rootless Podman's pasta copies the host's addresses when a container starts, so a bot that starts
# before the host has IPv6 stays IPv4-only until its next restart. Quadlet's own wait unit only
# polls network-online.target, and NetworkManager can report the network online before router
# advertisements have configured IPv6. This waits up to 60 seconds for a global address that has
# finished duplicate address detection and for an IPv6 default route.
#
# It never fails: a host without IPv6 still boots, and the bot then starts IPv4-only.
set -u

ip=/usr/sbin/ip
tries=0
while [ "$tries" -lt 120 ]; do
  # Global scope only, leaving out addresses still in, or failed, duplicate address detection and
  # deprecated ones, which the kernel no longer picks as a source.
  addresses=$("$ip" -6 -o address show scope global -tentative -dadfailed -deprecated 2>/dev/null)
  routes=$("$ip" -6 route show default 2>/dev/null)
  if [ -n "$addresses" ] && [ -n "$routes" ]; then
    echo "IPv6 is ready after $((tries / 2)) s."
    exit 0
  fi
  sleep 0.5
  tries=$((tries + 1))
done

echo "No global IPv6 address and default route after 60 s; continuing without IPv6." >&2
exit 0
