---
# ansible-lint's settings for TaruBot's playbooks (#62), site.yml and bot.yml. CI runs it pinned
# (requirements-lint.txt) and offline: the playbooks use ansible.builtin only, so nothing needs
# installing.
profile: production
offline: true
# The hashed requirements files aren't Ansible content.
exclude_paths:
  - requirements.txt
  - requirements-lint.txt
