<?xml version="1.0" encoding="UTF-8"?>
<!--
  Owner-applied backup retention; see docs/DEPLOYMENT.md "Backups and restore".
  Production and staging have separate prefixes: daily/settings copies for 30 days,
  and dumps from the 1st of each month for 365 days.
-->
<LifecycleConfiguration>
  <Rule>
    <ID>daily-dumps-30-days</ID>
    <Filter><Prefix>daily/</Prefix></Filter>
    <Status>Enabled</Status>
    <Expiration><Days>30</Days></Expiration>
  </Rule>
  <Rule>
    <ID>settings-copies-30-days</ID>
    <Filter><Prefix>env/</Prefix></Filter>
    <Status>Enabled</Status>
    <Expiration><Days>30</Days></Expiration>
  </Rule>
  <Rule>
    <ID>monthly-dumps-365-days</ID>
    <Filter><Prefix>monthly/</Prefix></Filter>
    <Status>Enabled</Status>
    <Expiration><Days>365</Days></Expiration>
  </Rule>
  <Rule>
    <ID>staging-daily-dumps-30-days</ID>
    <Filter><Prefix>staging/daily/</Prefix></Filter>
    <Status>Enabled</Status>
    <Expiration><Days>30</Days></Expiration>
  </Rule>
  <Rule>
    <ID>staging-settings-copies-30-days</ID>
    <Filter><Prefix>staging/env/</Prefix></Filter>
    <Status>Enabled</Status>
    <Expiration><Days>30</Days></Expiration>
  </Rule>
  <Rule>
    <ID>staging-monthly-dumps-365-days</ID>
    <Filter><Prefix>staging/monthly/</Prefix></Filter>
    <Status>Enabled</Status>
    <Expiration><Days>365</Days></Expiration>
  </Rule>
</LifecycleConfiguration>
