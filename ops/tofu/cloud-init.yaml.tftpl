#cloud-config
# TaruBot host user data, rendered per host by OpenTofu from ops/tofu/cloud-init.yaml.tftpl.
# cloud-init owns exactly six things: the hostname, root's SSH keys, root's password (the owner's
# console-only hash, or locked), password SSH off, the Python bindings Ansible needs, and the
# verify-required seed below. Everything else is ops/ansible/site.yml's. No host key is carried
# here: the host makes its own Ed25519 key at first boot, and the owner pins it from their own
# machine (trust on first use).
hostname: ${jsonencode(hostname)}
fqdn: ${jsonencode(fqdn)}
# No default user: root takes the keys below, without cloud-init's "log in as ..." prefix.
users: []
disable_root: false
ssh_pwauth: false
# One host key, the host's own: delete the image's keys and generate only Ed25519.
ssh_deletekeys: true
ssh_genkeytypes: [ed25519]
ssh_authorized_keys:
%{ for k in root_keys ~}
  - ${jsonencode(k)}
%{ endfor ~}
write_files:
  - path: /etc/ssh/sshd_config.d/00-tarubot.conf
    owner: root:root
    permissions: '0600'
    content: |
      # cloud-init 24.4 drops the options on root's key lines (cc_ssh passes options=""), so sshd requires a verified FIDO key itself.
      # Non-FIDO keys are unaffected. Configure (ops/ansible/site.yml) replaces this file with the full drop-in.
      PubkeyAuthOptions verify-required
%{ if root_password_hash != "" ~}
# Root's password is the owner's hash, for the Lish console only (sshd refuses passwords).
chpasswd:
  expire: false
  users:
    - {name: root, type: hash, password: ${jsonencode(root_password_hash)}}
%{ else ~}
# No hash given: lock root's password, the random throwaway main.tf gives the Linode.
runcmd:
  - [usermod, --lock, root]
%{ endif ~}
packages: [python3, python3-libselinux]
