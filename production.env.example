# Private production host settings: copy to ~/tarubot/.env, chmod 600, then replace
# every placeholder. The deployment entry never rewrites this file. Release image
# identity comes from the approved digest request and durable host current record.
# Compiled maintenance tools may use a separate mode-600 copy with effects disabled.
TARUBOT_ENVIRONMENT=production
POSTGRES_PASSWORD=
# Direct managed PostgreSQL port 27520, never transaction-pool port 27521.
# The production tool profile requires this direct port; TLS verifies this CA.
DATABASE_URL=postgresql://tarubot:REPLACE_WITH_DATABASE_PASSWORD@REPLACE_WITH_DATABASE_HOST:27520/tarubot
DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----
REPLACE_WITH_DATABASE_CA_CERTIFICATE
-----END CERTIFICATE-----"
# Only for checking a restored disposable database against its own CA.
RESTORE_DATABASE_CA_CERT=
DISCORD_TOKEN=REPLACE_WITH_PRODUCTION_BOT_TOKEN
# Must be the production application's ID accepted by src/config/deployment.ts.
DISCORD_APPLICATION_ID=REPLACE_WITH_PRODUCTION_APPLICATION_ID
TEST_GUILD_ID=
PUBLIC_TEST_RESPONSES=false
TEST_PLAN_CHANNEL_ID=
TEST_PLAN_FILE=test-plans/current.json
LOG_LEVEL=info
ENABLE_EFFECTS=true
ROSTER_INTERVAL_SECONDS=21600
PROFILE_INTERVAL_SECONDS=86400
VERIFICATION_SECONDS=1800
GUEST_COOLDOWN_SECONDS=86400
HEALTH_PORT=3000
LODESTONE_REGION=na
LODESTONE_CONCURRENCY=2
LODESTONE_START_MS=1000
LODESTONE_TIMEOUT_MS=15000
LODESTONE_BODY_BYTES=2000000
LODESTONE_REQUEST_TIMEOUT_MS=35000
LODESTONE_JOB_TIMEOUT_MS=300000
LODESTONE_ATTEMPTS=3
LODESTONE_MAX_PAGES=100
LODESTONE_SELECTOR_CHECK_SECONDS=900
# Optional report and suggestion credentials reach only the bot, never the dump job.
GITHUB_REPORTS_TOKEN=
GITHUB_REPORTS_REPO=deconfined/tarubot-reports
GITHUB_APP_CLIENT_ID=
GITHUB_APP_PRIVATE_KEY=
HEALTHCHECKS_PING_URL=
# HTTPS offsite object-storage bucket with write-only backup credentials. These
# settings reach only ops/backup.sh; Compose does not pass them to the bot or dump.
BACKUP_STORAGE_ENDPOINT=REPLACE_WITH_HTTPS_BUCKET_HOST
BACKUP_STORAGE_ACCESS_KEY=REPLACE_WITH_BACKUP_ACCESS_KEY
BACKUP_STORAGE_SECRET_KEY=REPLACE_WITH_BACKUP_SECRET_KEY
BACKUP_STORAGE_REGION=REPLACE_WITH_BUCKET_SIGNING_REGION
HEALTHCHECKS_BACKUP_URL=
