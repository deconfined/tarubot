# Production maintenance-tool environment for the TaruBot application 965294750741692416.
# Copy it OUTSIDE any checkout (for example ~/tarubot-cutover/production.env, chmod 600) and replace
# the placeholders. Never name the copy .env or .env.production, and never use `bun run` with it:
#   env -i HOME="$HOME" PATH="$PATH" bun --env-file="$TARUBOT_PRODUCTION_ENV" dist/scripts/<tool>.js
# Every .env.example key is listed so no development value can fill a gap. A rehearsal uses a second
# copy (rehearsal.env) with TARUBOT_ENVIRONMENT=rehearsal and a *_rehearsal DATABASE_URL, so no password
# appears on a command line. See docs/MIGRATION.md (E0).
# The secrets are plain values here. Inside a Quadlet host's container the tools read them from the
# files NAME_FILE names instead (ops/quadlet/README.md, "Secrets"); a run never sets both forms.
TARUBOT_ENVIRONMENT=production
# Unused by the tools (it configures a local Compose database); empty so nothing local leaks in.
POSTGRES_PASSWORD=
# Linode managed PostgreSQL tarubot-pgsql: the direct port 27520 (never the 27521 pool), as the tarubot user.
DATABASE_URL=postgresql://tarubot:REPLACE_WITH_TARUBOT_PASSWORD@REPLACE_WITH_CLUSTER_HOST:27520/tarubot
# The managed cluster's CA certificate, quoted across lines.
DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----
REPLACE_WITH_MANAGED_CLUSTER_CA_CERTIFICATE
-----END CERTIFICATE-----"
# Only for check-restore against a PITR fork with its own CA; empty reuses DATABASE_CA_CERT.
RESTORE_DATABASE_CA_CERT=
# Compose image selection; unused by the compiled tools.
TARUBOT_IMAGE_TAG=latest
TARUBOT_IMAGE=
# Paste the token only after the reset at the start of the window.
DISCORD_TOKEN=
DISCORD_APPLICATION_ID=965294750741692416
# Production never carries development scoping: these stay present and empty.
TEST_GUILD_ID=
PUBLIC_TEST_RESPONSES=false
TEST_PLAN_CHANNEL_ID=
TEST_PLAN_FILE=test-plans/current.json
LOG_LEVEL=info
# The tools never deliver effects; activation enables them for the guild.
ENABLE_EFFECTS=false
ROSTER_INTERVAL_SECONDS=21600
PROFILE_INTERVAL_SECONDS=86400
VERIFICATION_SECONDS=1800
GUEST_COOLDOWN_SECONDS=86400
HEALTH_PORT=3000
# Tools that read the Lodestone (acquire.js) parse in their own process (2.21.0: no sidecar).
LODESTONE_REGION=na
LODESTONE_CONCURRENCY=2
LODESTONE_START_MS=1000
LODESTONE_TIMEOUT_MS=15000
LODESTONE_BODY_BYTES=2000000
LODESTONE_REQUEST_TIMEOUT_MS=35000
LODESTONE_JOB_TIMEOUT_MS=300000
LODESTONE_ATTEMPTS=3
LODESTONE_MAX_PAGES=100
# Issue reports are sent by the running bot, not by maintenance tools; leave the token empty here.
GITHUB_REPORTS_TOKEN=
GITHUB_REPORTS_REPO=deconfined/tarubot-reports
# Public suggestions (2.28.0) are posted by the running bot as the TaruBot GitHub App, not by
# maintenance tools; leave both empty here. The host's .env holds them (docs/HOSTING.md).
GITHUB_APP_CLIENT_ID=
GITHUB_APP_PRIVATE_KEY=
# The heartbeat is sent by the running bot, not by maintenance tools; leave it empty here.
HEALTHCHECKS_PING_URL=
LODESTONE_SELECTOR_CHECK_SECONDS=900
