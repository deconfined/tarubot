# Dependencies and generated output are reproducible from source and bun.lock.
node_modules/
.cache/
dist/
coverage/
# Astro's generated content types for the documentation site (site/.astro).
.astro/
# Local coding-tool state is not part of the application.
.serena/
# Runtime secrets are local; the documented example is intentionally tracked.
.env
.env.*
!.env.example
# Operator env files such as production.env; the production.env.example template stays tracked.
*.env
# Ignore any private infrastructure state or inputs kept during owner operations.
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
plan.bin
*.tfvars
*.tfvars.json
backend.hcl
# Captures, reports, and diagnostics may contain guild-owned operational information.
artifacts/
# The supplied database dump is a local migration fixture and may contain private records.
tarubot_backup.sql
*.dump
*.backup
*.log
.DS_Store
