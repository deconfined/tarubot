# Omit repository metadata and local build/test working state.
.git
**/.git
.serena
.cache
node_modules
**/node_modules
dist
coverage
# The documentation site's build output and generated types. site/src stays: the unit tests read it.
site/dist
site/.astro
artifacts
# Credentials and legacy inputs enter only at runtime/cutover, never through image layers.
.env
.env.*
*.env
**/*.env
# The non-secret templates are unit-tested inside the build stage; the runtime stages never copy them.
!.env.example
# So are the Quadlet unit's setting lists (#50), which hold names and fixed public values only.
!ops/quadlet/units/tarubot.env
!ops/quadlet/production/target.env
!ops/quadlet/staging/target.env
tarubot_backup.sql
*.log
.DS_Store
