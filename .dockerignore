# Omit repository metadata and local build/test working state, including OpenTofu's provider
# downloads from a local `tofu init` (#62).
.git
**/.git
**/.terraform
# Keep local infrastructure values, state and saved plans out of COPY . and build caches.
**/*.tfstate
**/*.tfstate.*
**/*.tfplan
**/plan.bin
**/*.tfvars
**/*.tfvars.json
**/backend.hcl
# CI and the image's unit tests need only the committed, non-secret infrastructure examples.
!ops/tofu/examples/*.tfvars.json
.serena
.cache
node_modules
**/node_modules
dist
coverage
# The documentation site's build output and generated types. site/src stays: the unit tests read it.
site/dist
site/.astro
artifacts
# Credentials and legacy inputs enter only at runtime/cutover, never through image layers.
.env
.env.*
*.env
**/*.env
# The non-secret templates are unit-tested inside the build stage; the runtime stages never copy them.
!.env.example
tarubot_backup.sql
# Operator database backups may use names other than the supplied acceptance fixture.
**/*.dump
**/*.backup
*.log
.DS_Store
